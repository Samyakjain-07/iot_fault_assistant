# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# --- EMQX Cloud (MQTT) ---
MQTT_BROKER_HOST=your-deployment.emqxsl.com
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=true

# --- AWS (used from Phase 10 onward) ---
# Prefer `aws configure` / an IAM role over putting keys here. Only set
# these if you have no other way to provide credentials locally.
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- LLM backend ---
LLM_BACKEND=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# --- Misc ---
LOG_LEVEL=INFO
